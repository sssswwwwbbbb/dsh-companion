      "fallback": "空白则不显示可选气泡",
      "runtime": "仅本地设计模拟",
      "maxLength": 40
    },
    "clickCooldown": {
      "label": "点击冷却",
      "type": "number",
      "default": 2,
      "group": "更多",
      "decision": "待验证",
      "dependency": "点击调度去重字段；活动中重复触发固定合并",
      "display": "点击回应开启",
      "fallback": "使用本套默认",
      "runtime": "仅本地设计模拟",
      "min": 0,
      "max": 10,
      "step": 1
    },
    "completion": {
      "label": "任务完成反馈",
      "type": "boolean",
      "default": true,
      "group": "更多",
      "decision": "待验证",
      "dependency": "当前会话已验证事件桥接；尚未接入",
      "display": "始终",
      "fallback": "只保留原会话结果",
      "runtime": "仅本地设计模拟"
    },
    "needsFeedback": {
      "label": "需要处理提示",
      "type": "boolean",
      "default": true,
      "group": "更多",
      "decision": "待验证",
      "dependency": "当前会话需处理/解除事件",
      "display": "本套声明工作反馈",
      "fallback": "原会话需处理状态仍保留",
      "runtime": "仅本地设计模拟"
    },
    "bubbles": {
      "label": "显示短气泡",
      "type": "boolean",
      "default": true,
      "group": "更多",
      "decision": "首版设计（待复审）",
      "dependency": "可选文案层，与反馈状态独立",
      "display": "本套声明反馈或点击",
      "fallback": "省略气泡；需处理状态仍冻结且有固定提示",
      "runtime": "仅本地设计模拟"
    },
    "cooldown": {
      "label": "完成提醒间隔",
      "type": "number",
      "default": 30,
      "group": "更多",
      "decision": "待验证",
      "dependency": "完成事件去重和冷却字段",
      "display": "任务完成反馈开启",
      "fallback": "使用本套默认",
      "runtime": "仅本地设计模拟",
      "min": 5,
      "max": 300,
      "step": 5
    },
    "completionAction": {
      "label": "完成动作",
      "type": "enum",
      "default": "greet",
      "group": "更多",
      "decision": "待验证",
      "dependency": "同角色 greet/stretch/idle 姿态；完整动画待制作",
      "display": "任务完成反馈开启",
      "fallback": "使用本套默认",
      "runtime": "仅本地设计模拟",
      "values": [
        "greet",
        "stretch",
        "idle"
      ]
    },
    "completionText": {
      "label": "完成短句",
      "type": "text",
      "default": "这件事，做好了。",
      "group": "更多",
      "decision": "待验证",
      "dependency": "完成气泡纯文本",
      "display": "完成反馈与气泡开启",
      "fallback": "空白则不显示可选气泡",
      "runtime": "仅本地设计模拟",
      "maxLength": 60
    },
    "needsText": {
      "label": "处理短句",
      "type": "text",
      "default": "有一项事情需要你看看。",
      "group": "更多",
      "decision": "待验证",
      "dependency": "需处理气泡纯文本；不替代原始会话",
      "display": "需处理提示与气泡开启",
      "fallback": "空白不显示气泡，固定状态提示保留",
      "runtime": "仅本地设计模拟",
      "maxLength": 60
    },
    "mappingEnabled": {
      "label": "启用专属规则",
      "type": "boolean",
      "default": false,
      "group": "更多",
      "decision": "待验证",
      "dependency": "已验证模型/事件 ID 与映射模块；尚未接入",
      "display": "本套声明工作反馈",
      "fallback": "回本套默认动作和文案",
      "runtime": "仅本地设计模拟"
    },
    "eventRules": {
      "label": "模型与状态规则",
      "type": "rules",
      "default": [
        {
          "id": "sample-deepseek-complete",
          "enabled": true,
          "model": "example-deepseek",
          "event": "completed",
          "action": "stretch",
          "text": "这一项，已经整理好了。"
        }
      ],
      "group": "更多",
      "decision": "待验证",
      "dependency": "示例 ID 只用于模拟；真实模型/会话/状态信号待底座验证",
      "display": "启用专属规则",
      "fallback": "无匹配/规则关闭回本套默认；需处理动作限定静态 idle",
      "runtime": "仅本地设计模拟",
      "maxRules": 8
    },
    "startup": {
      "label": "启动开场",
      "type": "boolean",
      "default": true,
      "group": "更多",
      "decision": "待验证",
      "dependency": "启动生命周期；扫描原片仅参考",
      "display": "始终",
      "fallback": "立即进入工作区",
      "runtime": "仅本地设计模拟"
    },
    "startupStyle": {
      "label": "开场方案",
      "type": "enum",
      "default": "scan",
      "group": "更多",
      "decision": "待验证",
      "dependency": "档案底板与扫描参考；新模块未开放",
      "display": "启动开场开启",
      "fallback": "纯档案或直接进入工作区",
      "runtime": "仅本地设计模拟",
      "values": [
        "scan",
        "archive"
      ]
    },
    "startupPolicy": {
      "label": "自动播放条件",
      "type": "enum",
      "default": "cold",
      "group": "更多",
      "decision": "待验证",
      "dependency": "已确认冷启动/运行中启用规则与新开场模块",
      "display": "启动开场开启",
      "fallback": "只允许手动预览",
      "runtime": "仅本地设计模拟",
      "values": [
        "cold",
        "manual"
      ]
    }
  },
  "unsupportedHidden": [
    "character-costume-selector",
    "sound-volume",
    "arbitrary-colors",
    "font-family-upload",
    "real-model-character-mapping",
    "input-monitor",
    "external-wallpaper",
    "market",
    "creator-editor"
  ],
  "globalPreviewDefaults": {
    "stopped": false,
    "muted": true
  },
  "scope": "Local design preview. No user DSH data, credentials, or external requests."
}
