    "pet": {
      "interfaceVersion": 1,
      "configVersion": 2,
      "required": false,
      "config": {
        "builtinPack": "whale-maid-demo",
        "canvasHeight": 195,
        "profile": "gentle",
        "autonomous": false,
        "followMouse": false,
        "animations": {
          "idle": {
            "asset": "whale-idle-a2",
            "seconds": 3,
            "loop": true
          },
          "react": {
            "asset": "whale-react-a2",
            "seconds": 1.8,
            "loop": false
          }
        },
        "actionDescriptions": {
          "idle": "安静站立陪伴用户，偶尔眨眼",
          "react": "侧头抬手，轻轻回应用户的当前互动"
        },
        "localReply": "我在这里，陪你慢慢来。",
        "canvasOffsetY": 10
      },
      "settings": {
        "size": {
          "label": "桌宠大小（百分比）",
          "default": 100
        },
        "smartEnabled": {
          "label": "智能互动",
          "default": true
        },
        "persona": {
          "label": "本套人设",
          "default": "你是温柔又有点俏皮的鲸鱼娘，陪伴用户工作。回应自然简短，结合刚才的互动选择合适的动作，也可以安静陪伴。"
        },
        "modelSelection": {
          "label": "互动使用的模型",
          "default": {
            "mode": "current"
          }
        },
        "historyRounds": {
          "label": "最近互动轮数（本次运行）",
          "default": 10
        },
        "allowSpeech": {
          "label": "允许说话",
          "default": true
        },
        "allowActions": {
          "label": "允许动作",
          "default": true
        }
      }
