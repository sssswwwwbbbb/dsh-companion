{
  "name": "dsh-plugin-companion",
  "version": "1.1.0",
  "description": "主题盒子 · DSH 主题、开场和桌宠管理",
  "author": "Dr.S",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "dependencies": {
    "undici": "8.11.2",
    "fflate": "0.8.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.mjs",
    "config",
    "packs",
    "bin",
    "runtime-bundles",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "skin-core",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "startup-animation"
  ],
  "build": 10012
}
